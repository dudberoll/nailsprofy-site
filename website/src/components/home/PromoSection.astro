---
interface Props {
	bookingHref: string;
}

const { bookingHref } = Astro.props;
---

<section class="promo-grid" aria-label="Специальные предложения">
	<article class="promo-card promo-card--wide">
		<div>
			<h2>Попробуйте пилочный маникюр</h2>
			<p>
				Он особенно комфортен для тонкой, сухой и чувствительной кутикулы.
				Работаем пилками Japure с японским абразивом.
				<strong>На первую процедуру скидка 500&nbsp;₽.</strong>
			</p>
		</div>
		<a class="shader-booking-button" href={bookingHref}>Выбрать удобное время</a>
	</article>

	<article class="promo-card promo-card--gift">
		<div>
			<h2>Подарочный сертификат</h2>
			<p>Тёплый способ подарить близкому человеку время для себя.</p>
		</div>
		<a href="/sertifikaty_abonementy">Выбрать номинал</a>
	</article>
</section>

<style>
	.promo-grid { display: grid; grid-template-columns: minmax(0, 808.672fr) minmax(0, 557.711fr); gap: 34.539px; width: min(100%, 1400.922px); margin-inline: auto; padding-top: 38.22px; }
	.promo-card { display: flex; flex-direction: column; justify-content: start; min-height: 352.797px; padding: 56px 35.46px 21.86px; border-radius: 0; background: transparent; }
	.promo-card--gift { overflow: hidden; padding-top: 81.1px; border-radius: 29.4px; background: linear-gradient(rgb(26 26 26 / 54%), rgb(26 26 26 / 54%)), url("/images/certificate-care.webp") left center / 140% auto no-repeat, #1a1a1a; color: #fffdf9; }
	.promo-card h2 { margin: 0; color: var(--color-text); font-size: 40px; font-weight: 300; line-height: 51.9px; letter-spacing: -2px; }
	.promo-card.promo-card--gift h2, .promo-card.promo-card--gift p { color: #fffdf9; }
	.promo-card p { max-width: 730px; margin: 0; color: var(--color-muted); font-size: 24px; line-height: 28px; }
	.promo-card--wide p { margin-top: 8px; }
	.promo-card--gift p { max-width: 460px; margin-top: 4px; font-size: 21px; line-height: 21px; }
	.promo-card a { display: inline-flex; align-items: center; justify-content: center; width: fit-content; min-height: 43.66px; margin-top: 65.9px; padding: .72rem 2rem; border: 1px solid var(--color-accent); border-radius: 999px; background: var(--color-accent); color: var(--color-accent-text); text-decoration: none; font-size: 16px; line-height: 1; }
	.promo-card a.shader-booking-button { border-color: var(--shader-booking-border); background: var(--shader-booking-background); color: var(--shader-booking-text); }
	.promo-card--gift a { margin-top: 59.7px; border-color: #fffdf9; background: #fffdf9; }
	@media (min-width: 768px) and (max-width: 1439px) { .promo-grid { grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr); gap: clamp(1rem, 2.4vw, 2rem); padding-top: clamp(1.5rem, 3vw, 2rem); } .promo-card { min-height: clamp(250px, 25vw, 330px); padding: clamp(1.5rem, 3.2vw, 2.5rem); } .promo-card--gift { padding-top: clamp(2rem, 4vw, 3.5rem); } .promo-card h2 { font-size: clamp(1.7rem, 3.1vw, 2.5rem); line-height: 1.08; letter-spacing: -.05em; } .promo-card p { font-size: clamp(1rem, 1.8vw, 1.35rem); line-height: 1.32; } .promo-card--gift p { font-size: clamp(.95rem, 1.55vw, 1.2rem); line-height: 1.2; } .promo-card a { min-height: 42px; margin-top: auto; padding-inline: clamp(1rem, 2vw, 1.5rem); font-size: clamp(.82rem, 1.2vw, 1rem); } }
	@media (max-width: 767px) {
		.promo-grid { grid-template-columns: 1fr; gap: 12px; padding-top: 12px; }
		.promo-card { min-height: 184px; padding: 20px 18px; border-radius: 18px; }
		.promo-card--gift { min-height: 210px; padding-top: 22px; }
		.promo-card h2 { font-size: clamp(1.25rem, 6vw, 1.55rem); line-height: 1.08; letter-spacing: -.04em; }
		.promo-card p, .promo-card--gift p { margin-top: 7px; font-size: clamp(.78rem, 3.5vw, .9rem); line-height: 1.35; }
		.promo-card a, .promo-card--gift a { min-height: 36px; margin-top: auto; padding: .5rem 1rem; font-size: clamp(.75rem, 3.2vw, .86rem); }
		.promo-card--wide a { margin-top: 12px; }
	}
</style>
