---
const masters = [
	["Анна", "Ногтевой сервис, аккуратная форма и спокойная работа с деталями"],
	["Оксана", "Педикюр, уход за стопами и чистое покрытие без лишней графичности"],
	["Василиса", "Брови, мягкая коррекция и оттенок под естественные черты лица"],
	["Екатерина", "Волосы, укладки и уход с учетом структуры и домашней рутины"],
	["Дарья", "Маникюр, восстановление ногтей и сдержанные повседневные дизайны"],
	["Полина", "Комплексные визиты и бережная координация нескольких услуг"],
];
---

<section class="masters-section" id="masters" aria-labelledby="masters-title">
	<div class="section-heading">
		<h2 id="masters-title">Мастера, которым можно доверить детали</h2>
	</div>

	<div class="masters-stage">
		<div class="masters-carousel" data-masters-carousel aria-label="Карточки мастеров">
			{
				masters.map(([title, text]) => (
					<article class="master-card">
						<div class="master-card__photo" aria-hidden="true"></div>
						<div>
							<h3>{title}</h3>
							<p>{text}</p>
						</div>
					</article>
				))
			}
		</div>

		<div class="masters-controls" aria-label="Управление прокруткой">
			<button type="button" aria-label="Предыдущие мастера" data-masters-action="-1">←</button>
			<button type="button" aria-label="Следующие мастера" data-masters-action="1">→</button>
		</div>
	</div>
</section>

<script>
	const mastersCarousel = document.querySelector<HTMLElement>("[data-masters-carousel]");
	const mastersButtons = document.querySelectorAll<HTMLButtonElement>("[data-masters-action]");

	mastersButtons.forEach((button) => {
		button.addEventListener("click", () => {
			const card = mastersCarousel?.querySelector<HTMLElement>(".master-card");
			if (!mastersCarousel || !card) return;

			mastersCarousel.scrollBy({
				left: (card.offsetWidth + 19) * Number(button.dataset.mastersAction),
				behavior: "smooth",
			});
		});
	});
</script>

<style>
	.masters-section {
		min-height: 601.539px;
	}

	.masters-section .section-heading h2 {
		margin: 64.7px 0 0;
		max-width: 1073px;
		color: var(--color-text);
		font-size: 52.9px;
		font-weight: 400;
		line-height: 51.9px;
		letter-spacing: -2.9px;
	}

	.masters-stage {
		position: relative;
		height: 283px;
		margin-top: 158px;
		overflow: hidden;
		border-radius: 29.4px;
		background:
			radial-gradient(ellipse at 28% 0%, rgb(234 208 220 / 86%), transparent 36%),
			radial-gradient(ellipse at 69% 0%, rgb(234 208 220 / 74%), transparent 40%),
			linear-gradient(180deg, #fffdf9, #f7f2ed);
	}

	.masters-carousel {
		position: relative;
		display: flex;
		gap: 19px;
		height: 100%;
		overflow-x: auto;
		padding: 19px 43px 80px;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}

	.masters-carousel::-webkit-scrollbar {
		display: none;
	}

	.master-card {
		position: relative;
		flex: 0 0 442px;
		align-self: start;
		min-height: 174px;
		padding: 46px 64px 24px;
		border: 1px solid rgb(255 255 255 / 52%);
		border-radius: 14.7px;
		background: rgb(255 253 249 / 58%);
		box-shadow: 0 18px 55px rgb(70 53 45 / 8%);
	}

	.master-card__photo {
		position: absolute;
		top: 20px;
		left: 64px;
		width: 70px;
		height: 70px;
		border-radius: 999px;
		background:
			linear-gradient(145deg, rgb(255 255 255 / 66%), rgb(255 255 255 / 18%)),
			#d8d2cb;
		transform: translateY(-50%);
	}

	.master-card h3 {
		margin: 0;
		color: var(--color-text);
		font-size: 29.4px;
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: -1.6px;
	}

	.master-card p {
		max-width: 223px;
		margin: 14px 0 0;
		color: rgb(23 25 22 / 80%);
		font-size: 14.7px;
		line-height: 16.9px;
		letter-spacing: -0.5px;
	}

	.masters-controls {
		position: absolute;
		right: 55px;
		bottom: 26px;
		display: flex;
		gap: 18px;
	}

	.masters-controls button {
		width: 31px;
		height: 31px;
		border: 1px solid rgb(23 25 22 / 14%);
		border-radius: 999px;
		background: rgb(255 253 249 / 68%);
		color: rgb(23 25 22 / 78%);
		cursor: pointer;
	}

	@media (max-width: 1119px) {
		.masters-section {
			min-height: auto;
		}

		.masters-section .section-heading h2 {
			margin-top: 3rem;
			font-size: clamp(2.3rem, 7vw, 4rem);
			line-height: 1.05;
			letter-spacing: 0;
		}

		.masters-stage {
			height: auto;
			margin-top: 2rem;
		}

		.masters-carousel {
			padding: 2rem 1rem 5rem;
		}

		.master-card {
			flex-basis: 320px;
			padding-inline: 1.5rem;
		}
	}
</style>
