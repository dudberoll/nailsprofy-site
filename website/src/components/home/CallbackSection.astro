---
interface Props {
	phones: string[];
	telegramUrl?: string;
	whatsappUrl?: string;
	maxUrl?: string;
}

const { phones, telegramUrl, whatsappUrl, maxUrl } = Astro.props;
const phoneLinks = phones.map((phone) => ({
	label: phone,
	href: `tel:${phone.replace(/[^\d+]/g, "")}`,
}));
---

<section class="callback-section" aria-labelledby="callback-title">
	<div class="callback-copy">
		<h2 id="callback-title">Остались вопросы?</h2>
		<p>
			Позвоните нам или напишите в мессенджере — ответим на вопросы и поможем подобрать
			услугу.
		</p>
	</div>
	<div class="callback-contacts" aria-label="Контакты салона">
		{
			phoneLinks.map((phone) => (
				<a class="callback-contact callback-contact--phone" href={phone.href}>{phone.label}</a>
			))
		}
		<div class="callback-messengers">
			{
				telegramUrl && (
					<a
						class="callback-contact callback-contact--messenger"
						href={telegramUrl}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Telegram"
					>
						<img
							class="callback-contact__brand-icon"
							src="/icons/telegram.svg"
							alt=""
							width="28"
							height="28"
						/>
					</a>
				)
			}
			{
				whatsappUrl && (
					<a
						class="callback-contact callback-contact--messenger"
						href={whatsappUrl}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="WhatsApp"
					>
						<img
							class="callback-contact__brand-icon"
							src="/icons/whatsapp.svg"
							alt=""
							width="28"
							height="28"
						/>
					</a>
				)
			}
			{
				maxUrl && (
					<a
						class="callback-contact callback-contact--messenger"
						href={maxUrl}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="MAX"
					>
						<img
							class="callback-contact__brand-icon"
							src="/icons/max.svg"
							alt=""
							width="28"
							height="28"
						/>
					</a>
				)
			}
		</div>
	</div>
</section>

<style>
	.callback-section {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.5rem, 2.2vw, 3rem);
		width: 100%;
		min-height: clamp(310px, 18.5vw, 384px);
		margin: clamp(1rem, 2.4vw, 2.75rem) auto 0;
		padding: clamp(2.5rem, 5vw, 4.75rem) clamp(2rem, 3vw, 4rem);
		border: 1px solid rgb(255 255 255 / 45%);
		border-radius: clamp(1.5rem, 2vw, 2rem);
		background:
			radial-gradient(circle at 72% 12%, rgb(255 255 255 / 62%), transparent 38%),
			linear-gradient(120deg, #f1efec, #f6f3f0 52%, #efedea);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 55%);
	}

	.callback-copy {
		min-width: 0;
	}

	.callback-section h2 {
		margin: 0;
		color: var(--color-text);
		font-size: clamp(3rem, 3.6vw, 4.5rem);
		font-weight: 300;
		line-height: 0.98;
		letter-spacing: -0.055em;
		white-space: nowrap;
	}

	.callback-section p {
		max-width: 35rem;
		margin: clamp(1.35rem, 2.2vw, 2rem) 0 0;
		color: var(--color-muted);
		font-size: clamp(1rem, 1.3vw, 1.2rem);
		line-height: 1.55;
	}

	.callback-contacts {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		justify-content: flex-end;
		gap: clamp(0.45rem, 0.65vw, 0.75rem);
	}

	.callback-contact {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 0;
		min-height: 54px;
		gap: 0.5rem;
		padding: 0.75rem 1rem;
		border: 1px solid rgb(109 103 97 / 28%);
		border-radius: 999px;
		background: rgb(255 253 250 / 86%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 70%);
		color: var(--color-text);
		text-align: center;
		text-decoration: none;
		font-size: clamp(0.8rem, 0.9vw, 0.95rem);
		font-weight: 500;
		line-height: 1;
		white-space: nowrap;
		transition:
			border-color 160ms var(--ease-out),
			box-shadow 160ms var(--ease-out),
			transform 120ms var(--ease-out);
	}

	.callback-contact--phone {
		min-width: clamp(10.25rem, 12vw, 11.75rem);
	}

	.callback-contact--messenger {
		width: 48px;
		min-height: 48px;
		padding: 0;
	}

	.callback-messengers {
		display: contents;
	}

	.callback-contact__brand-icon {
		display: block;
		flex: 0 0 auto;
		width: 1.7rem;
		height: 1.7rem;
	}

	.callback-contact__brand-icon {
		object-fit: contain;
	}

	.callback-contact:active {
		transform: scale(0.97);
	}

	@media (hover: hover) and (pointer: fine) {
		.callback-contact:hover {
			border-color: rgb(109 103 97 / 50%);
			box-shadow:
				inset 0 1px 0 rgb(255 255 255 / 70%),
				0 8px 22px rgb(72 61 54 / 8%);
		}
	}

	@media (max-width: 1119px) {
		.callback-section {
			grid-template-columns: 1fr;
			min-height: 0;
		}

		.callback-section h2 {
			white-space: normal;
		}

		.callback-contacts {
			flex-wrap: wrap;
			justify-content: flex-start;
		}

		.callback-messengers {
			display: flex;
			justify-content: center;
			width: 100%;
			gap: inherit;
		}
	}

	@media (max-width: 767px) {
		.callback-section {
			gap: 1.75rem;
			padding: 2rem 1.5rem 1.5rem;
			border-radius: 1.35rem;
		}

		.callback-section h2 {
			font-size: clamp(2.5rem, 12vw, 3.25rem);
		}

		.callback-section p {
			margin-top: 1.15rem;
			font-size: 1rem;
			line-height: 1.5;
		}

		.callback-contacts {
			display: flex;
			flex-wrap: wrap;
			gap: 0.65rem;
		}

		.callback-contact--phone {
			width: 100%;
			min-height: 54px;
		}

		.callback-contact--messenger {
			width: 54px;
			min-height: 54px;
		}
	}
</style>
