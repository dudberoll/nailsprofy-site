---
import type { BlogArticle } from "../data/blog";
import {
	articlePath,
	blogCategories,
	blogCategoryPath,
	type BlogCategorySlug,
} from "../data/blog";

interface Props {
	articles: BlogArticle[];
	currentPage: number;
	totalPages: number;
	activeCategory: BlogCategorySlug;
}

const { articles, currentPage, totalPages, activeCategory } = Astro.props;
---

<main id="main-content" class="blog-page">
	<section class="blog-hero" aria-labelledby="blog-title">
		<h1 id="blog-title">Статьи и советы от нашего салона</h1>
		<nav class="blog-filters" aria-label="Темы блога">
			{
				blogCategories.map((category) => (
					<a class={category.slug === activeCategory ? "blog-filter blog-filter--active" : "blog-filter"} href={blogCategoryPath(category.slug)}>
						{category.label}
					</a>
				))
			}
		</nav>
	</section>

	<section class="blog-all-section" aria-labelledby="blog-all-title">
		<div class="blog-section-head">
			<p id="blog-all-title">Все статьи</p>
			<span class="blog-page-count">Страница {currentPage} из {totalPages}</span>
		</div>
		<div class="blog-list">
			{
				articles.map((article) => (
					<article class="blog-card">
						<p>{article.category}</p>
						<h2>{article.title}</h2>
						<span>{article.text}</span>
						<a class="blog-read-button" href={articlePath(article)}>
							<span>Читать далее</span>
							<svg aria-hidden="true" viewBox="0 0 24 10" focusable="false">
								<path d="M1 5h20m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>
					</article>
				))
			}
		</div>
		<nav class="blog-pagination" aria-label="Пагинация блога">
			{
				currentPage > 1 ? (
					<a href={blogCategoryPath(activeCategory, currentPage - 1)}>Назад</a>
				) : (
					<span aria-disabled="true">Назад</span>
				)
			}
			{
				currentPage < totalPages ? (
					<a href={blogCategoryPath(activeCategory, currentPage + 1)}>Вперёд</a>
				) : (
					<span aria-disabled="true">Вперёд</span>
				)
			}
		</nav>
	</section>
</main>

<style>
	.blog-page {
		width: min(100%, calc(var(--content-width) + var(--page-gutter)));
		margin-inline: auto;
		padding: clamp(1.5rem, 2.8vw, 3rem) var(--page-gutter) clamp(2rem, 4vw, 4.5rem);
	}

	.blog-hero h1 {
		max-width: 980px;
		margin: 0;
		color: var(--color-text);
		font-size: clamp(2.5rem, 5vw, 5.8rem);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: 0;
	}

	.blog-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: clamp(1rem, 1.6vw, 1.5rem);
	}

	.blog-filter {
		appearance: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: clamp(4.8rem, 7vw, 7.8rem);
		min-height: 38px;
		padding: 0.55rem 1.25rem;
		border: 1px solid rgb(105 101 96 / 18%);
		border-radius: 999px;
		background: rgb(255 255 255 / 34%);
		color: rgb(23 25 22 / 82%);
		font: inherit;
		font-size: 0.93rem;
		line-height: 1.1;
		text-decoration: none;
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 54%);
	}

	.blog-filter--active {
		border-color: rgb(105 101 96 / 24%);
		background: #d7d3cc;
		color: #2f2d2a;
	}

	.blog-section-head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
	}

	.blog-section-head p,
	.blog-page-count {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.blog-all-section {
		display: grid;
		gap: clamp(1rem, 1.7vw, 1.5rem);
		margin-top: clamp(1.35rem, 2.3vw, 2.5rem);
	}

	.blog-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--page-gutter);
	}

	.blog-card {
		display: grid;
		align-content: start;
		min-height: 225px;
		padding: clamp(1.25rem, 1.7vw, 1.9rem);
		border: 1px solid rgb(255 255 255 / 56%);
		border-radius: clamp(1rem, 1.4vw, 1.45rem);
		background:
			linear-gradient(145deg, rgb(255 255 255 / 86%), rgb(239 236 230 / 66%)),
			radial-gradient(circle at 88% 14%, rgb(112 124 101 / 10%), transparent 34%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 76%),
			0 16px 42px rgb(55 45 38 / 7%);
	}

	.blog-card p {
		margin: 0;
		color: #7d7468;
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.blog-card h2 {
		margin: 1.2rem 0 0;
		color: var(--color-text);
		font-size: clamp(1.32rem, 1.7vw, 2rem);
		font-weight: 400;
		line-height: 1.14;
		letter-spacing: 0;
	}

	.blog-card > span {
		display: block;
		max-width: 34ch;
		margin-top: 1.25rem;
		color: var(--color-muted);
		font-size: clamp(0.93rem, 1vw, 1rem);
		line-height: 1.45;
	}

	.blog-read-button {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		width: fit-content;
		margin-top: auto;
		padding-top: clamp(1.5rem, 3vw, 2.5rem);
		color: #7d7468;
		font-size: 0.88rem;
		line-height: 1.15;
		text-decoration: none;
	}

	.blog-read-button svg {
		width: 1.35rem;
		height: auto;
		transition: transform 160ms var(--ease-out);
	}

	.blog-read-button:hover,
	.blog-read-button:focus-visible {
		color: #4f5946;
	}

	.blog-read-button:hover svg,
	.blog-read-button:focus-visible svg {
		transform: translateX(0.16rem);
	}

	.blog-pagination {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		margin-top: clamp(0.75rem, 1.4vw, 1.25rem);
	}

	.blog-pagination a,
	.blog-pagination span {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 40px;
		padding: 0.6rem 1.1rem;
		border: 1px solid rgb(105 101 96 / 18%);
		border-radius: 999px;
		background: rgb(255 255 255 / 42%);
		color: rgb(23 25 22 / 82%);
		font-size: 0.93rem;
		text-decoration: none;
	}

	.blog-pagination span {
		opacity: 0.42;
	}

	@media (max-width: 1100px) {
		.blog-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.blog-page {
			padding-top: 1.75rem;
		}

		.blog-section-head {
			align-items: flex-start;
			flex-direction: column;
		}

		.blog-list {
			grid-template-columns: 1fr;
		}

		.blog-filter {
			min-width: 0;
			min-height: 44px;
			padding-inline: 1rem;
		}

		.blog-pagination a,
		.blog-pagination span {
			min-height: 44px;
		}
	}
</style>
