		backdrop-filter: blur(22px) saturate(112%);
	}

	.matte-card--carousel {
		flex: 0 0 calc((100% - (var(--matte-carousel-gap) * 2)) / 2.72);
		scroll-snap-align: center;
	}

	.matte-card h3 {
