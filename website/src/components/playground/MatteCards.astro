<script>
	const matteCarousels = document.querySelectorAll<HTMLElement>("[data-matte-carousel]");
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	matteCarousels.forEach((carousel) => {
		if (reducedMotion.matches) return;

		let animationFrame = 0;
		let lastTime = 0;
		let isPaused = false;
		let resumeTimer = 0;

		const maxScroll = () => carousel.scrollWidth - carousel.clientWidth;
		const scrollStep = () => {
			const card = carousel.querySelector<HTMLElement>(".matte-card--carousel");
			const style = window.getComputedStyle(carousel);
			const gap = Number.parseFloat(style.columnGap || style.gap || "0");

			return card ? card.getBoundingClientRect().width + gap : carousel.clientWidth * 0.8;
		};

		const pause = () => {
			isPaused = true;
			window.clearTimeout(resumeTimer);
		};

		const resumeSoon = () => {
			window.clearTimeout(resumeTimer);
			resumeTimer = window.setTimeout(() => {
				lastTime = 0;
				isPaused = false;
			}, 1400);
		};

		const tick = (time: number) => {
			if (!lastTime) lastTime = time;

			const delta = time - lastTime;
			lastTime = time;

			if (!isPaused && maxScroll() > 0) {
				carousel.scrollLeft += delta * 0.022;

				if (carousel.scrollLeft >= maxScroll() - 2) {
					carousel.scrollLeft = 0;
				}
			}

			animationFrame = window.requestAnimationFrame(tick);
		};

		window.requestAnimationFrame(() => {
			carousel.scrollLeft = Math.min(72, maxScroll());
			animationFrame = window.requestAnimationFrame(tick);
		});

		carousel.addEventListener("pointerenter", pause);
		carousel.addEventListener("pointerleave", resumeSoon);
		carousel.addEventListener("pointerdown", pause);
		carousel.addEventListener("pointerup", resumeSoon);
		carousel.addEventListener("touchend", resumeSoon);
		carousel.addEventListener("focusin", pause);
		carousel.addEventListener("focusout", resumeSoon);

		const stage = carousel.closest<HTMLElement>(".matte-cards-demo__stage");
		const controls = stage?.querySelectorAll<HTMLButtonElement>("[data-matte-carousel-action]");

		controls?.forEach((control) => {
			control.addEventListener("click", () => {
				const direction =
					control.dataset.matteCarouselAction === "previous" ? -1 : 1;

				pause();
				carousel.scrollBy({
					left: scrollStep() * direction,
					behavior: "smooth",
				});
				resumeSoon();
			});
		});

		window.addEventListener("pagehide", () => {
			window.cancelAnimationFrame(animationFrame);
			window.clearTimeout(resumeTimer);
		});
	});
</script>

<style>
	.matte-cards-demo {
		display: grid;
		gap: clamp(1.5rem, 3vw, 2.5rem);
		width: min(100%, var(--content-width));
