		left: clamp(1rem, 2vw, 1.75rem);
		z-index: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 220px;
		min-height: 58px;
		padding-inline: 1.4rem;
		border: 1px solid rgb(133 79 55 / 28%);
		border-radius: 999px;
		background: #c98c72;
		color: #fff8f3;
		text-decoration: none;
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 30%),
			0 14px 34px rgb(130 73 48 / 20%);
		transition:
			background-color 160ms var(--ease-out),
			transform 120ms var(--ease-out);
	}

	.matte-cards-demo__button:active {
		transform: scale(0.98);
	}

	@media (hover: hover) and (pointer: fine) {
		.matte-cards-demo__button:hover {
			background: #bd7c62;
		}

		.matte-carousel-control:hover {
			border-color: rgb(23 25 22 / 24%);
			background: rgb(255 255 255 / 48%);
			color: var(--color-text);
