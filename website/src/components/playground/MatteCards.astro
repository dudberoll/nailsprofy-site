		aspect-ratio: 1;
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 999px;
		object-fit: cover;
		background:
			linear-gradient(145deg, rgb(255 255 255 / 54%), rgb(255 255 255 / 18%)),
			radial-gradient(circle at 32% 26%, rgb(201 140 114 / 28%), transparent 46%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 58%),
			0 16px 38px rgb(72 57 45 / 8%);
	}

	.master-card__copy {
