		display: none;
	}

	.matte-cards-demo__stage--masters .matte-card {
		background: rgb(238 235 230 / 50%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 50%);
		backdrop-filter: none;
	}

	.matte-cards-demo__stage--masters .matte-carousel {
		padding-top: 28px;
	}

	.matte-cards-demo__branch {
		position: absolute;
		inset: 0;
		pointer-events: none;
		filter: blur(0.2px);
		opacity: 0.72;
	}

	.matte-cards-demo__branch::before {
		position: absolute;
		top: -12%;
		left: 47%;
		width: 34px;
		height: 92%;
		border-radius: 999px;
		background: linear-gradient(180deg, #9f634b, #6f4b37 56%, #3e5f38);
		content: "";
		transform: rotate(-14deg);
	}

	.matte-cards-demo__branch span {
		position: absolute;
		display: block;
		border-radius: 999px;
		background: linear-gradient(90deg, #9c5f49, #df9b7f 45%, #805640);
	}

	.matte-cards-demo__branch span:first-child {
		top: 22%;
		left: 39%;
		width: 22%;
		height: 28px;
		filter: blur(7px);
		transform: rotate(-18deg);
	}

	.matte-cards-demo__branch span:last-child {
		top: 56%;
		left: 48%;
		width: 24%;
		height: 22px;
		background: linear-gradient(90deg, #345934, #7c8a61);
		transform: rotate(48deg);
	}

	.matte-cards {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.75rem, 1.4vw, 1.25rem);
		padding: clamp(1rem, 2vw, 1.75rem);
	}

	.matte-carousel {
		--matte-carousel-gap: clamp(0.75rem, 1.4vw, 1.25rem);

		position: relative;
		z-index: 1;
		display: flex;
		gap: var(--matte-carousel-gap);
		min-width: 0;
		overflow-x: auto;
		overscroll-behavior-inline: contain;
		padding: clamp(1rem, 2vw, 1.75rem) clamp(1.25rem, 6vw, 5rem);
		scroll-padding-inline: clamp(1.25rem, 6vw, 5rem);
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}

	.matte-carousel::-webkit-scrollbar {
		display: none;
	}

	.matte-carousel-controls {
		position: absolute;
		right: clamp(1rem, 2vw, 1.75rem);
		bottom: clamp(1rem, 2vw, 1.75rem);
		z-index: 2;
		display: flex;
		gap: 0.55rem;
	}

	.matte-carousel-control {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		padding: 0;
		border: 1px solid rgb(23 25 22 / 14%);
		border-radius: 999px;
		background: rgb(255 255 255 / 30%);
		color: rgb(23 25 22 / 78%);
		backdrop-filter: blur(18px) saturate(112%);
		cursor: pointer;
		transition:
			background-color 160ms var(--ease-out),
			border-color 160ms var(--ease-out),
			color 160ms var(--ease-out),
			transform 120ms var(--ease-out);
	}

	.matte-carousel-control svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.matte-carousel-control:active {
		transform: scale(0.96);
	}

	.matte-card {
		display: grid;
		align-content: space-between;
		min-height: clamp(190px, 18vw, 280px);
		padding: clamp(1.1rem, 1.8vw, 1.75rem);
		border: 1px solid rgb(255 255 255 / 46%);
		border-radius: clamp(1.15rem, 1.6vw, 1.75rem);
		background: rgb(255 255 255 / 32%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 50%),
