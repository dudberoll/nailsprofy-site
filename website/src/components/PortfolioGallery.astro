---
import { portfolioItems } from "../data/portfolio";
---

<main id="main-content" class="portfolio-page">
	<header class="portfolio-hero">
		<div>
			<p class="portfolio-eyebrow">Портфолио · {portfolioItems.length} работ</p>
			<h1>Работы наших мастеров</h1>
		</div>
	</header>

	<section class="portfolio-grid" aria-label="Работы мастеров NailsProfi">
		{
			portfolioItems.map((item, index) => (
				<button
					class="portfolio-card"
					type="button"
					data-portfolio-open
					aria-label={`Увеличить фотографию: ${item.alt}`}
				>
					<span class="portfolio-card__image">
						<img
							src={item.image}
							width={item.width}
							height={item.height}
							alt={item.alt}
							loading={index === 0 ? "eager" : "lazy"}
							decoding="async"
						/>
					</span>
				</button>
			))
		}
	</section>
</main>

<dialog class="portfolio-lightbox" data-portfolio-lightbox aria-label="Просмотр работы">
	<div class="portfolio-lightbox__content">
		<img class="portfolio-lightbox__image" data-portfolio-lightbox-image alt="" />
		<button
			class="portfolio-lightbox__close"
			type="button"
			data-portfolio-lightbox-close
			aria-label="Закрыть фотографию"
		>
			<span aria-hidden="true">×</span>
		</button>
	</div>
</dialog>

<script>
	const gallery = document.querySelector<HTMLElement>(".portfolio-grid");
	const lightbox = document.querySelector<HTMLDialogElement>("[data-portfolio-lightbox]");
	const lightboxImage = lightbox?.querySelector<HTMLImageElement>(
		"[data-portfolio-lightbox-image]",
	);
	const closeButton = lightbox?.querySelector<HTMLButtonElement>(
		"[data-portfolio-lightbox-close]",
	);

	gallery?.addEventListener("click", (event) => {
		const opener = (event.target as HTMLElement).closest<HTMLButtonElement>(
			"[data-portfolio-open]",
		);
		const source = opener?.querySelector<HTMLImageElement>("img");

		if (!source || !lightbox || !lightboxImage) return;

		lightboxImage.src = source.currentSrc || source.src;
		lightboxImage.alt = source.alt;
		lightbox.showModal();
	});

	closeButton?.addEventListener("click", () => lightbox?.close());
	lightbox?.addEventListener("click", (event) => {
		if (event.target === lightbox) lightbox.close();
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && lightbox?.open) lightbox.close();
	});
</script>

<style>
	.portfolio-page {
		width: min(100%, calc(var(--content-width) + 2 * var(--page-gutter)));
		margin-inline: auto;
		padding: clamp(2rem, 4.25vw, 5.25rem) var(--page-gutter) clamp(3rem, 6vw, 7rem);
	}

	.portfolio-hero {
		margin-bottom: clamp(0.9rem, 1.5vw, 1.5rem);
	}

	.portfolio-eyebrow {
		margin: 0 0 clamp(0.9rem, 1.5vw, 1.5rem);
		color: var(--color-muted);
		font-size: 0.76rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.portfolio-hero h1 {
		margin: 0;
		font-size: clamp(2.25rem, 3.7vw, 3.3rem);
		font-weight: 300;
		line-height: 1.02;
		letter-spacing: -0.055em;
		white-space: nowrap;
	}

	.portfolio-grid {
		columns: 4;
		column-gap: clamp(1rem, 1.7vw, 2rem);
	}

	.portfolio-card {
		display: block;
		break-inside: avoid;
		width: 100%;
		min-width: 0;
		margin: 0 0 clamp(1rem, 1.7vw, 2rem);
		padding: 0;
		border: 0;
		background: transparent;
		cursor: zoom-in;
	}

	.portfolio-card__image {
		display: block;
		overflow: hidden;
		border-radius: clamp(1.2rem, 1.6vw, 1.85rem);
		background: var(--color-surface);
	}

	.portfolio-card img {
		display: block;
		width: 100%;
		height: auto;
		transition:
			filter 240ms var(--ease-out),
			transform 240ms var(--ease-out);
	}

	.portfolio-lightbox {
		position: fixed;
		inset: 0;
		display: none;
		place-items: center;
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: clamp(1.25rem, 4vw, 3rem);
		border: 0;
		background: transparent;
		overflow: hidden;
	}

	.portfolio-lightbox[open] {
		display: grid;
	}

	.portfolio-lightbox::backdrop {
		background: rgb(22 20 18 / 78%);
		backdrop-filter: blur(6px);
	}

	.portfolio-lightbox__content {
		position: relative;
		width: fit-content;
		max-width: 100%;
	}

	.portfolio-lightbox__image {
		display: block;
		width: auto;
		height: auto;
		max-width: min(90vw, 1100px);
		max-height: min(85dvh, 900px);
		border-radius: clamp(1rem, 1.5vw, 1.5rem);
		box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 30%);
		object-fit: contain;
	}

	.portfolio-lightbox__close {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid rgb(255 255 255 / 35%);
		border-radius: 50%;
		background: rgb(20 18 16 / 65%);
		color: white;
		font-size: 1.75rem;
		line-height: 1;
		cursor: pointer;
		backdrop-filter: blur(8px);
	}

	.portfolio-lightbox__close span {
		transform: translateY(-0.08em);
	}

	@media (hover: hover) and (pointer: fine) {
		.portfolio-card:hover img {
			filter: brightness(0.96);
			transform: scale(1.015);
		}
	}

	@media (max-width: 1250px) {
		.portfolio-grid {
			columns: 3;
		}
	}

	@media (max-width: 900px) {
		.portfolio-grid {
			columns: 2;
		}
	}

	@media (max-width: 600px) {
		.portfolio-page {
			padding-top: 2.25rem;
			padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
		}

		.portfolio-hero h1 {
			font-size: clamp(1.4rem, 6vw, 1.65rem);
		}

		.portfolio-grid {
			columns: 2;
		}

		.portfolio-card {
			margin-bottom: 1rem;
		}

		.portfolio-card__image {
			border-radius: 1.5rem;
		}

		.portfolio-lightbox__image {
			max-width: 92vw;
			max-height: 82dvh;
		}
	}
</style>
