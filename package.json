{
  "name": "nailsprofy-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["website"],
  "scripts": {
    "dev": "bun run --cwd website dev",
    "build": "bun run --cwd website build",
    "typecheck": "bun run --cwd website typecheck",
    "check:assets": "bun run scripts/verify-assets.mjs",
    "check:deploy": "bash deploy/check.sh",
    "check": "bun run typecheck && bun run check:assets && bun run check:deploy && bun run build",
    "preview": "bun run --cwd website preview"
  }
}
